cabal-version:      3.4
name:               sara
version:            0.1.0.0
synopsis:           Simple, Adaptive, Responsive Architecture — Industrial Haskell SSG
description:
  SARA is a high-performance static site generator built on Shake.
  It provides type-safe routing, universal frontmatter parsing,
  human-first error messages, security-by-construction, and migration
  tools for Jekyll/Hugo/Hakyll.
license:            MPL-2.0
license-file:       LICENSE
author:             C Sabrinathan
maintainer:         bombay.boyz@hotmail.com
copyright:          2026 C Sabrinathan
category:           Web, Development
build-type:         Simple
homepage:           https://github.com/Bombay-Boyz/sara
bug-reports:        https://github.com/Bombay-Boyz/sara/issues
tested-with:
  GHC == 9.4.7
  , GHC == 9.6.6
  , GHC == 9.8.4
  , GHC == 9.10.1
  , GHC == 9.12.4
  , GHC == 9.14.1
extra-source-files:
  templates/**/*.html
  docs/*.md
  .hlint.yaml
  README.md
  CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/Bombay-Boyz/sara.git

-- | -Werror is opt-in via this flag rather than unconditional, per
--   `cabal check`'s own advice: since sara.cabal claims support for
--   GHC 9.4.7 through 9.14.1 (see tested-with above), a warning that's
--   new in a GHC version we haven't seen yet would otherwise turn into
--   a hard build failure for everyone on that compiler, the moment it
--   ships — including end users who just want to build the package,
--   not just the CI machine catching new lint before merge. CI builds
--   every supported GHC version with this flag enabled (see
--   .github/workflows/ci.yml), so the zero-warnings guarantee is still
--   verified on every commit; it's just not baked into what a plain
--   `cabal build` does for someone building from a released tarball on
--   a GHC version newer than any this project has tested against yet.
flag werror
  description: Turn on -Werror (used in CI; left off by default so a future GHC's new warnings don't turn into a hard failure for end users building from source)
  default:      False
  manual:       True

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wno-unused-do-bind
    -Wredundant-constraints
    -Wpartial-fields
    -Wunused-imports
    -Wunused-top-binds
    -Wunused-local-binds
    -Wunused-matches
    -fhide-source-paths
  if flag(werror)
    ghc-options: -Werror

library
  import:             warnings
  hs-source-dirs:     src
  default-language:   GHC2021
  default-extensions:
    DataKinds
    GADTs
    KindSignatures
    LambdaCase
    OverloadedStrings
    ScopedTypeVariables
    StrictData
    TupleSections
    TypeFamilies
  exposed-modules:
    SARA
    SARA.Error
    SARA.Config
    SARA.Types
    SARA.Monad
    SARA.DSL
    SARA.FileSystem
    SARA.Security.PathGuard
    SARA.Security.GlobGuard
    SARA.Security.RegexGuard
    SARA.Security.HtmlEscape
    SARA.Security.ShellGuard
    SARA.Frontmatter.Detect
    SARA.Frontmatter.Parser
    SARA.Frontmatter.Remap
    SARA.Routing.Engine
    SARA.Routing.Types
    SARA.SEO.JsonLD
    SARA.SEO.OpenGraph
    SARA.SEO.Audit
    SARA.SEO.Sitemap
    SARA.SEO.Feed
    SARA.Validator.LinkChecker
    SARA.Validator.AssetChecker
    SARA.Migration.Detect
    SARA.Migration.TagTranslate
    SARA.Migration.Jekyll
    SARA.Migration.Scaffold
    SARA.Search.Index
    SARA.Template.Renderer
    SARA.Template.Lucid
    SARA.LiveReload.Server
    SARA.LiveReload.Watcher
    SARA.Migration.Hugo
    SARA.Migration.Hakyll
    SARA.Markdown.Shortcode
    SARA.Asset.Copy
    SARA.Asset.BinaryCheck
    SARA.Asset.Placeholder
    SARA.Content.Summary
    SARA.Content.Drafts
    SARA.Content.Taxonomy
    SARA.Content.Pagination
    SARA.Diagnostics
    SARA.Asset.Image
    SARA.Internal.FrontmatterCache
    SARA.Internal.TemplateCheck
    SARA.Search.Stemmer
  other-modules:
    SARA.Internal.Planner
    SARA.Internal.Engine
    SARA.Internal.Hash
    SARA.Internal.Aeson
    SARA.Internal.Toml
    SARA.Internal.RegexCompat
    SARA.Markdown.Parser
    SARA.Asset.Discover
  build-depends:
    base                     >= 4.16  && < 5,
    aeson                    >= 2.0,
    cryptohash-sha256        >= 0.11,
    base16-bytestring        >= 1.0,
    bytestring               >= 0.11,
    cmark-gfm                >= 0.2,
    filepattern              >= 0.1,
    filepath                 >= 1.4,
    fsnotify                 >= 0.4,
    JuicyPixels              >= 3.3,
    base64-bytestring        >= 1.2,
    ansi-terminal            >= 1.0,
    optparse-applicative     >= 0.18,
    prettyprinter            >= 1.7,
    prettyprinter-ansi-terminal >= 1.1,
    regex-tdfa               >= 1.3,
    regex-base               >= 0.94,
    shake                    >= 0.19,
    mustache                 >= 2.3,
    stm                      >= 2.5,
    tagsoup                  >= 0.14,
    text                     >= 1.2,
    xml-conduit              >= 1.9,
    megaparsec               >= 9.0,
    containers               >= 0.6,
    vector                   >= 0.13,
    array                    >= 0.5,
    unordered-containers     >= 0.2,
    mtl                      >= 2.2,
    warp                     >= 3.3,
    network                  >= 3.1,
    websockets               >= 0.12,
    yaml                     >= 0.11,
    lucid                    >= 2.11,
    time                     >= 1.9,
    async                    >= 2.2,
    directory                >= 1.3,
    binary                   >= 0.8,
    process                  >= 1.6,
    wai                      >= 3.2,
    wai-middleware-static    >= 0.9,
    wai-websockets           >= 3.0,
    http-types               >= 0.12,
    Glob                     >= 0.10 && < 0.11

executable sara
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  -- Required for SARA.Internal.Engine.executeBuild's parallel Shake
  -- builds to actually take effect (shakeThreads is a no-op without
  -- the threaded RTS -- GHC's default runtime has exactly one
  -- capability regardless of what shakeThreads requests). This only
  -- benefits builds this compiled executable runs directly (the
  -- zero-config default site) -- a project's own site.hs, run via
  -- runghc as this CLI's default today, is interpreted and cannot
  -- use the threaded RTS at all (runghc itself rejects -N flags
  -- outright: "requires the program to be built with -threaded").
  -- Full effect for real projects needs site.hs compiled, not
  -- interpreted -- see BUILD_AND_FIXES_SUMMARY.md's engineering
  -- roadmap, item #1.
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    base, sara, optparse-applicative, text, directory, warp, filepath, aeson, process, temporary

test-suite sara-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  other-modules:
    SARA.AdaptiveImageSpec
    SARA.BuildIssueReportSpec
    SARA.DraftsSpec
    SARA.TaxonomySpec
    SARA.PaginationSpec
    SARA.QualitySealBridgeSpec
    SARA.DryRunSpec
    SARA.EndToEndSpec
    SARA.FeatureIntegrationSpec
    SARA.EnhancedFeaturesSpec
    SARA.FrontmatterPropSpec
    SARA.FrontmatterSpec
    SARA.HedgehogSecuritySpec
    SARA.ImageFallbackSpec
    SARA.ContentGenerationSpec
    SARA.HedgehogExhaustiveSpec
    SARA.IntegrationSpec
    SARA.MigrationSpec
    SARA.OutlierSpec
    SARA.OutlierExhaustiveSpec
    SARA.PipelineSpec
    SARA.PropertySpec
    SARA.RoutePropSpec
    SARA.RoutingSpec
    SARA.SecurityPropSpec
    SARA.SecuritySpec
    SARA.SEOSpec
    SARA.SmokeSpec
    SARA.StemmerSpec
    SARA.StressSpec
    SARA.TemplateStandardSpec
    SARA.TemplateCheckSpec
    SARA.TypedMetadataSpec
  hs-source-dirs:   test
  default-language: GHC2021
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:
    base, sara,
    hspec          >= 2.11,
    QuickCheck     >= 2.14,
    aeson,
    cryptohash-sha256,
    bytestring,
    text,
    filepath,
    directory,
    temporary      >= 1.3,
    unordered-containers,
    containers,
    mtl,
    process,
    yaml,
    shake,
    hedgehog,
    hspec-hedgehog,
    vector,
    time,
    mustache           >= 2.3


benchmark sara-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   bench
  default-language: GHC2021
  build-depends:
    base, sara,
    criterion      >= 1.6,
    aeson,
    text,
    filepath,
    temporary
